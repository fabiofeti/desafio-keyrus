<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CashFlow.Modules.Consolidation.Domain\CashFlow.Modules.Consolidation.Domain.csproj" />
    <ProjectReference Include="..\CashFlow.Modules.Consolidation.IntegrationEvents\CashFlow.Modules.Consolidation.IntegrationEvents.csproj" />
    <ProjectReference Include="..\..\..\Common\CashFlow.Common.Application\CashFlow.Common.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the abstractions: a handler names DbSet<T> through
         IConsolidationDbContext, never a provider. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Handlers are internal sealed (an architecture test enforces it). -->
    <InternalsVisibleTo Include="CashFlow.Modules.Consolidation.UnitTests" />
    <InternalsVisibleTo Include="CashFlow.IntegrationTests" />
  </ItemGroup>

  <ItemGroup Label="Cross-module">
    <!-- The one reference the boundary allows: Transactions' public, versioned
         event contract. Consolidation hears that a transaction was recorded; it
         never learns where Transactions keeps its tables. -->
    <ProjectReference Include="..\..\Transactions\CashFlow.Modules.Transactions.IntegrationEvents\CashFlow.Modules.Transactions.IntegrationEvents.csproj" />
  </ItemGroup>

</Project>
