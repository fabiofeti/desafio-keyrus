{
  "openapi": "3.1.1",
  "info": {
    "title": "CashFlow.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/transactions": {
      "post": {
        "tags": [
          "Transactions"
        ],
        "summary": "Registra um crédito ou débito",
        "description": "Exige Idempotency-Key. Grava o lançamento e o evento na Outbox na mesma transação; não depende da consolidação.",
        "operationId": "CreateTransaction",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Obrigatório. Mesma chave e mesmo payload repetem a resposta; mesma chave e outro payload: 409.",
            "schema": {
              "pattern": "^[A-Za-z0-9_-]{1,100}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "description": "/transactions/{id} do lançamento.",
                "schema": {
                  "type": "string"
                }
              },
              "Idempotency-Replayed": {
                "description": "\"true\" quando a resposta repete um POST anterior com a mesma chave.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Lista os lançamentos de uma data de negócio",
        "description": "date no formato YYYY-MM-DD; page a partir de 1; pageSize entre 1 e 200 (padrão 50). Ordenado por occurredAt e id.",
        "operationId": "ListTransactions",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "description": "Data de negócio, YYYY-MM-DD.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "A partir de 1; padrão 1.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Entre 1 e 200; padrão 50.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponseOfTransactionListItem"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/daily-balances/{date}": {
      "get": {
        "tags": [
          "DailyBalances"
        ],
        "summary": "Saldo consolidado de uma data de negócio",
        "description": "date no formato YYYY-MM-DD. Consistência eventual: lastUpdatedAt diz quando o saldo mudou pela última vez; dia sem lançamento consolidado devolve zeros e lastUpdatedAt nulo.",
        "operationId": "GetDailyBalance",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "description": "Data de negócio, YYYY-MM-DD.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyBalanceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DailyBalanceResponse": {
        "required": [
          "date",
          "credits",
          "debits",
          "balance",
          "lastUpdatedAt",
          "consistency"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "credits": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "debits": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "balance": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "lastUpdatedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "consistency": {
            "type": "string"
          }
        }
      },
      "PagedResponseOfTransactionListItem": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionListItem"
            }
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Request": {
        "required": [
          "type",
          "amount",
          "occurredAt"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Credit ou Debit."
          },
          "amount": {
            "maximum": 999999999.99,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Valor positivo com até 2 casas decimais.",
            "format": "double"
          },
          "occurredAt": {
            "type": "string",
            "description": "Instante do lançamento com offset; a data de negócio é o dia desse instante em America/Sao_Paulo.",
            "format": "date-time"
          },
          "description": {
            "maxLength": 200,
            "type": [
              "null",
              "string"
            ],
            "description": "Texto livre opcional."
          }
        }
      },
      "TransactionListItem": {
        "required": [
          "id",
          "type",
          "amount",
          "occurredAt",
          "businessDate",
          "description",
          "createdAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "businessDate": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TransactionResponse": {
        "required": [
          "id",
          "type",
          "amount",
          "occurredAt",
          "businessDate",
          "description"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "businessDate": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Transactions"
    },
    {
      "name": "DailyBalances"
    }
  ]
}
