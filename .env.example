# Copy to .env (ignored by Git) and change the values. Never commit the .env.
POSTGRES_USER=cashflow_admin
POSTGRES_PASSWORD=change-me
TRANSACTIONS_APP_PASSWORD=change-me
CONSOLIDATION_APP_PASSWORD=change-me
RABBITMQ_USER=cashflow
RABBITMQ_PASSWORD=change-me

# Optional host ports (defaults: 5432, 5672, 15672, 8080). Change them when
# another local stack already uses one of these.
# POSTGRES_HOST_PORT=5432
# RABBITMQ_HOST_PORT=5672
# RABBITMQ_MANAGEMENT_HOST_PORT=15672
# API_HOST_PORT=8080
